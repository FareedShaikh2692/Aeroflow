<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.aeroflow</groupId><artifactId>aeroflow-backend</artifactId><version>1.0.0</version></parent>
  <artifactId>all-in-one</artifactId>
  <name>AeroFlow all-in-one</name>
  <description>Single deployable that hosts every AeroFlow service in one JVM (free-tier hosting mode)</description>
  <dependencies>
    <dependency><groupId>com.aeroflow</groupId><artifactId>auth-service</artifactId></dependency>
    <dependency><groupId>com.aeroflow</groupId><artifactId>flight-service</artifactId></dependency>
    <dependency><groupId>com.aeroflow</groupId><artifactId>passenger-service</artifactId></dependency>
    <dependency><groupId>com.aeroflow</groupId><artifactId>booking-service</artifactId></dependency>
    <dependency><groupId>com.aeroflow</groupId><artifactId>checkin-service</artifactId></dependency>
    <dependency><groupId>com.aeroflow</groupId><artifactId>notification-service</artifactId></dependency>
    <dependency><groupId>com.aeroflow</groupId><artifactId>reporting-service</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <finalName>app</finalName>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins>
  </build>
</project>
