# ---- AeroFlow environment (copy to .env and fill in; .env is git-ignored) ----
# Required: HMAC secret shared by all services for JWT signing (>= 32 bytes). Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PostgreSQL (each service uses its own database: aeroflow_auth, aeroflow_flight, ...)
DB_USERNAME=aeroflow
DB_PASSWORD=
POSTGRES_PASSWORD=          # superuser password for the docker-compose postgres container
# DB_URL is per-service; defaults to jdbc:postgresql://localhost:5432/<service database>

# Redis (gateway rate limiting, flight/booking caches)
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REPLICAS=1
# Managed Kafka over SASL_SSL: set SPRING_PROFILES_ACTIVE=cloud-kafka and
# KAFKA_SASL_MECHANISM=PLAIN KAFKA_USERNAME= KAFKA_PASSWORD=

# Gateway CORS - comma-separated exact origins and/or patterns (e.g. Vercel previews)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

# Seed data. Local/dev: SEED_DEMO_DATA=true seeds everything below.
# Production: SEED_DEMO_USERS=false, SEED_SYNTHETIC_HISTORY=false, SEED_FLIGHTS=true and set ADMIN_*.
SEED_DEMO_DATA=true
SEED_DEMO_USERS=
SEED_FLIGHTS=
SEED_SYNTHETIC_HISTORY=
DEMO_PASSWORD=Aeroflow@2026
# First SUPER_ADMIN (created once if missing; 10+ chars with upper, lower, digit, symbol)
ADMIN_EMAIL=
ADMIN_PASSWORD=
CHECKIN_OPENS_HOURS=48
GRAFANA_ADMIN_PASSWORD=
