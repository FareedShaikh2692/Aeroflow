{
    "openapi": "3.0.1",
    "info": {
        "title": "AeroFlow passenger-service API",
        "description": "AeroFlow Airline Operations & Passenger Management Platform",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8083",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/api/passengers/{id}": {
            "get": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "get",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PassengerDetail"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PassengerRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PassengerResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/api/passengers/me": {
            "get": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "me",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PassengerDetail"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "updateMe",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PassengerRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PassengerResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/passengers": {
            "get": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "list",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "tier",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "createdAt"
                        }
                    },
                    {
                        "name": "dir",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "desc"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponsePassengerResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Passengers"
                ],
                "operationId": "create",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PassengerRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PassengerResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PassengerRequest": {
                "required": [
                    "email",
                    "firstName",
                    "lastName"
                ],
                "type": "object",
                "properties": {
                    "firstName": {
                        "maxLength": 80,
                        "minLength": 0,
                        "pattern": "^[\\p{L} .'-]+$",
                        "type": "string"
                    },
                    "lastName": {
                        "maxLength": 80,
                        "minLength": 0,
                        "pattern": "^[\\p{L} .'-]+$",
                        "type": "string"
                    },
                    "email": {
                        "maxLength": 254,
                        "minLength": 0,
                        "type": "string"
                    },
                    "phone": {
                        "pattern": "^\\+?[0-9 ()-]{6,30}$",
                        "type": "string"
                    },
                    "dateOfBirth": {
                        "type": "string",
                        "format": "date"
                    },
                    "nationality": {
                        "pattern": "^[A-Z]{2}$",
                        "type": "string"
                    },
                    "passportNumber": {
                        "pattern": "^[A-Z0-9]{5,20}$",
                        "type": "string"
                    },
                    "passportExpiry": {
                        "type": "string",
                        "format": "date"
                    },
                    "addressLine": {
                        "maxLength": 200,
                        "minLength": 0,
                        "type": "string"
                    },
                    "city": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    },
                    "country": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    },
                    "notes": {
                        "maxLength": 1000,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "PassengerResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "userId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "dateOfBirth": {
                        "type": "string",
                        "format": "date"
                    },
                    "nationality": {
                        "type": "string"
                    },
                    "passportNumber": {
                        "type": "string"
                    },
                    "passportExpiry": {
                        "type": "string",
                        "format": "date"
                    },
                    "addressLine": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "loyaltyTier": {
                        "type": "string"
                    },
                    "loyaltyPoints": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "version": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            },
            "PageResponsePassengerResponse": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PassengerResponse"
                        }
                    },
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "totalPages": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "PassengerDetail": {
                "type": "object",
                "properties": {
                    "profile": {
                        "$ref": "#/components/schemas/PassengerResponse"
                    },
                    "travelHistory": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TravelRecordResponse"
                        }
                    },
                    "totalTrips": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "upcomingTrips": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "lifetimeSpend": {
                        "type": "number"
                    }
                }
            },
            "TravelRecordResponse": {
                "type": "object",
                "properties": {
                    "bookingId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "pnr": {
                        "type": "string"
                    },
                    "flightNumber": {
                        "type": "string"
                    },
                    "origin": {
                        "type": "string"
                    },
                    "destination": {
                        "type": "string"
                    },
                    "departureTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "checkedIn": {
                        "type": "boolean"
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
