{
    "openapi": "3.0.1",
    "info": {
        "title": "AeroFlow booking-service API",
        "description": "AeroFlow Airline Operations & Passenger Management Platform",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8084",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/api/bookings/{pnr}/passengers/{passengerId}/seat": {
            "put": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "staffSeatChange",
                "parameters": [
                    {
                        "name": "pnr",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "passengerId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SeatChangeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "search",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "CONFIRMED",
                                "CANCELLED"
                            ]
                        }
                    },
                    {
                        "name": "flightId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseBookingResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Create a booking as an authenticated passenger or agent. Requires Idempotency-Key.",
                "operationId": "create",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateBookingRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/{pnr}/cancel": {
            "post": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "cancel",
                "parameters": [
                    {
                        "name": "pnr",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CancelRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/retrieve": {
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Retrieve a booking with PNR + passenger last name (public)",
                "operationId": "retrieve",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RetrieveRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/quote": {
            "post": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "quote",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/QuoteRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/QuoteResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/guest": {
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Create a booking (guest or signed-in). Requires Idempotency-Key.",
                "operationId": "createGuest",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateBookingRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/guest/{pnr}/cancel": {
            "post": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Cancel as a guest (last name verification)",
                "operationId": "cancelGuest",
                "parameters": [
                    {
                        "name": "pnr",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CancelRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/seat-maps/{flightId}": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Seat map with occupied seats (public)",
                "operationId": "seatMap",
                "parameters": [
                    {
                        "name": "flightId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/SeatMapResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/{pnr}": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "get",
                "parameters": [
                    {
                        "name": "pnr",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookingResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/my": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "mine",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/BookingResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bookings/flight/{flightId}/manifest": {
            "get": {
                "tags": [
                    "Bookings"
                ],
                "operationId": "manifest",
                "parameters": [
                    {
                        "name": "flightId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PassengerResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "SeatChangeRequest": {
                "required": [
                    "seatNumber"
                ],
                "type": "object",
                "properties": {
                    "seatNumber": {
                        "pattern": "^\\d{1,2}[A-K]$",
                        "type": "string"
                    }
                }
            },
            "BookingResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "pnr": {
                        "type": "string"
                    },
                    "flightId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "flightNumber": {
                        "type": "string"
                    },
                    "origin": {
                        "type": "string"
                    },
                    "destination": {
                        "type": "string"
                    },
                    "departureTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "arrivalTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "CONFIRMED",
                            "CANCELLED"
                        ]
                    },
                    "totalAmount": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "contactEmail": {
                        "type": "string"
                    },
                    "contactPhone": {
                        "type": "string"
                    },
                    "paymentReference": {
                        "type": "string"
                    },
                    "cardBrand": {
                        "type": "string"
                    },
                    "cardLast4": {
                        "type": "string"
                    },
                    "channel": {
                        "type": "string"
                    },
                    "cancellationReason": {
                        "type": "string"
                    },
                    "cancelledAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "passengers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PassengerResponse"
                        }
                    },
                    "payments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PaymentResponse"
                        }
                    }
                }
            },
            "PassengerResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "dateOfBirth": {
                        "type": "string",
                        "format": "date"
                    },
                    "nationality": {
                        "type": "string"
                    },
                    "passportMasked": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "cabin": {
                        "type": "string",
                        "enum": [
                            "ECONOMY",
                            "BUSINESS"
                        ]
                    },
                    "seatNumber": {
                        "type": "string"
                    },
                    "fare": {
                        "type": "number"
                    },
                    "checkedIn": {
                        "type": "boolean"
                    },
                    "checkedInAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "PaymentResponse": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "amount": {
                        "type": "number"
                    },
                    "status": {
                        "type": "string"
                    },
                    "reference": {
                        "type": "string"
                    },
                    "at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "CreateBookingRequest": {
                "required": [
                    "contactEmail",
                    "flightId",
                    "passengers",
                    "payment"
                ],
                "type": "object",
                "properties": {
                    "flightId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "passengers": {
                        "maxItems": 9,
                        "minItems": 0,
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PassengerRequest"
                        }
                    },
                    "contactEmail": {
                        "maxLength": 254,
                        "minLength": 0,
                        "type": "string"
                    },
                    "contactPhone": {
                        "pattern": "^\\+?[0-9 ()-]{6,30}$",
                        "type": "string"
                    },
                    "payment": {
                        "$ref": "#/components/schemas/PaymentRequest"
                    }
                }
            },
            "PassengerRequest": {
                "required": [
                    "cabin",
                    "firstName",
                    "lastName"
                ],
                "type": "object",
                "properties": {
                    "firstName": {
                        "maxLength": 80,
                        "minLength": 0,
                        "pattern": "^[\\p{L} .'-]+$",
                        "type": "string"
                    },
                    "lastName": {
                        "maxLength": 80,
                        "minLength": 0,
                        "pattern": "^[\\p{L} .'-]+$",
                        "type": "string"
                    },
                    "dateOfBirth": {
                        "type": "string",
                        "format": "date"
                    },
                    "nationality": {
                        "pattern": "^[A-Z]{2}$",
                        "type": "string"
                    },
                    "passportNumber": {
                        "pattern": "^[A-Z0-9]{5,20}$",
                        "type": "string"
                    },
                    "email": {
                        "maxLength": 254,
                        "minLength": 0,
                        "type": "string"
                    },
                    "cabin": {
                        "type": "string",
                        "enum": [
                            "ECONOMY",
                            "BUSINESS"
                        ]
                    },
                    "seatNumber": {
                        "pattern": "^\\d{1,2}[A-K]$",
                        "type": "string"
                    }
                }
            },
            "PaymentRequest": {
                "required": [
                    "cardHolder",
                    "cardNumber",
                    "cvv",
                    "expiry"
                ],
                "type": "object",
                "properties": {
                    "cardNumber": {
                        "pattern": "^[0-9 -]{12,23}$",
                        "type": "string"
                    },
                    "expiry": {
                        "pattern": "^(0[1-9]|1[0-2])/\\d{2}$",
                        "type": "string"
                    },
                    "cvv": {
                        "pattern": "^\\d{3,4}$",
                        "type": "string"
                    },
                    "cardHolder": {
                        "maxLength": 100,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "CancelRequest": {
                "type": "object",
                "properties": {
                    "lastName": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    },
                    "reason": {
                        "maxLength": 300,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "RetrieveRequest": {
                "required": [
                    "lastName",
                    "pnr"
                ],
                "type": "object",
                "properties": {
                    "pnr": {
                        "pattern": "^[A-Za-z0-9]{6}$",
                        "type": "string"
                    },
                    "lastName": {
                        "maxLength": 80,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "QuoteRequest": {
                "required": [
                    "cabins",
                    "flightId"
                ],
                "type": "object",
                "properties": {
                    "flightId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "cabins": {
                        "maxItems": 9,
                        "minItems": 0,
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "ECONOMY",
                                "BUSINESS"
                            ]
                        }
                    }
                }
            },
            "QuoteResponse": {
                "type": "object",
                "properties": {
                    "flightId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "total": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "fares": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        }
                    }
                }
            },
            "SeatMapResponse": {
                "type": "object",
                "properties": {
                    "flightId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "flightNumber": {
                        "type": "string"
                    },
                    "aircraftModel": {
                        "type": "string"
                    },
                    "businessRows": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "businessLayout": {
                        "type": "string"
                    },
                    "economyRows": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "economyLayout": {
                        "type": "string"
                    },
                    "occupied": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "economyFare": {
                        "type": "number"
                    },
                    "businessFare": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "available": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "PageResponseBookingResponse": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BookingResponse"
                        }
                    },
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "totalPages": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
