{
    "openapi": "3.0.1",
    "info": {
        "title": "AeroFlow flight-service API",
        "description": "AeroFlow Airline Operations & Passenger Management Platform",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8082",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/api/flights/{id}": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "operationId": "get",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightResponse"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Flights"
                ],
                "summary": "Update a flight; pass If-Match with the version for optimistic concurrency",
                "operationId": "update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "If-Match",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FlightRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Flights"
                ],
                "operationId": "delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/api/flights": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "operationId": "list",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "SCHEDULED",
                                "DELAYED",
                                "BOARDING",
                                "DEPARTED",
                                "ARRIVED",
                                "CANCELLED"
                            ]
                        }
                    },
                    {
                        "name": "origin",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "destination",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 20
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "departureTime"
                        }
                    },
                    {
                        "name": "dir",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "asc"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PageResponseFlightResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Flights"
                ],
                "operationId": "create",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/FlightRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/aircraft": {
            "get": {
                "tags": [
                    "Reference data"
                ],
                "operationId": "fleet",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/AircraftResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Reference data"
                ],
                "operationId": "create_1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AircraftRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AircraftResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/flights/{id}/status": {
            "patch": {
                "tags": [
                    "Flights"
                ],
                "summary": "Change operational status: delay, board, depart, arrive or cancel",
                "operationId": "changeStatus",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StatusChangeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/aircraft/{id}/status": {
            "patch": {
                "tags": [
                    "Reference data"
                ],
                "operationId": "status",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AircraftResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/internal/flights/{id}": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "operationId": "internalGet",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/flights/stats": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "operationId": "stats",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightStats"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/flights/search": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "summary": "Public flight search by route and local departure date",
                "operationId": "search",
                "parameters": [
                    {
                        "name": "origin",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "pattern": "^[A-Za-z]{3}$",
                            "type": "string"
                        }
                    },
                    {
                        "name": "destination",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "pattern": "^[A-Za-z]{3}$",
                            "type": "string"
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/FlightResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/flights/public/{id}": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "summary": "Public flight details (used by booking and check-in flows)",
                "operationId": "publicGet",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/FlightResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/airports": {
            "get": {
                "tags": [
                    "Reference data"
                ],
                "operationId": "airports",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/AirportResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "FlightRequest": {
                "required": [
                    "aircraftId",
                    "arrivalTime",
                    "businessFare",
                    "departureTime",
                    "destinationCode",
                    "economyFare",
                    "flightNumber",
                    "originCode"
                ],
                "type": "object",
                "properties": {
                    "flightNumber": {
                        "pattern": "^[A-Z0-9]{2}\\d{1,4}$",
                        "type": "string"
                    },
                    "originCode": {
                        "maxLength": 3,
                        "minLength": 3,
                        "type": "string"
                    },
                    "destinationCode": {
                        "maxLength": 3,
                        "minLength": 3,
                        "type": "string"
                    },
                    "aircraftId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "departureTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "arrivalTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "economyFare": {
                        "minimum": 1.0,
                        "exclusiveMinimum": false,
                        "type": "number"
                    },
                    "businessFare": {
                        "minimum": 1.0,
                        "exclusiveMinimum": false,
                        "type": "number"
                    },
                    "gate": {
                        "maxLength": 6,
                        "minLength": 0,
                        "type": "string"
                    },
                    "terminal": {
                        "maxLength": 4,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "AircraftResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "registration": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string"
                    },
                    "manufacturer": {
                        "type": "string"
                    },
                    "capacity": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "businessSeats": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "economySeats": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "status": {
                        "type": "string"
                    },
                    "layout": {
                        "$ref": "#/components/schemas/SeatLayout"
                    }
                }
            },
            "AirportResponse": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    }
                }
            },
            "FlightResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "flightNumber": {
                        "type": "string"
                    },
                    "origin": {
                        "$ref": "#/components/schemas/AirportResponse"
                    },
                    "destination": {
                        "$ref": "#/components/schemas/AirportResponse"
                    },
                    "aircraft": {
                        "$ref": "#/components/schemas/AircraftResponse"
                    },
                    "departureTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "arrivalTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "estimatedDepartureTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "durationMinutes": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "capacity": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "SCHEDULED",
                            "DELAYED",
                            "BOARDING",
                            "DEPARTED",
                            "ARRIVED",
                            "CANCELLED"
                        ]
                    },
                    "delayMinutes": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "statusReason": {
                        "type": "string"
                    },
                    "gate": {
                        "type": "string"
                    },
                    "terminal": {
                        "type": "string"
                    },
                    "economyFare": {
                        "type": "number"
                    },
                    "businessFare": {
                        "type": "number"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "version": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "SeatLayout": {
                "type": "object",
                "properties": {
                    "businessRows": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "businessLayout": {
                        "type": "string"
                    },
                    "economyRows": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "economyLayout": {
                        "type": "string"
                    }
                }
            },
            "AircraftRequest": {
                "required": [
                    "businessLayout",
                    "economyLayout",
                    "manufacturer",
                    "model",
                    "registration"
                ],
                "type": "object",
                "properties": {
                    "registration": {
                        "pattern": "^[A-Z0-9-]{3,10}$",
                        "type": "string"
                    },
                    "model": {
                        "maxLength": 60,
                        "minLength": 0,
                        "type": "string"
                    },
                    "manufacturer": {
                        "maxLength": 60,
                        "minLength": 0,
                        "type": "string"
                    },
                    "businessRows": {
                        "maximum": 20,
                        "minimum": 0,
                        "type": "integer",
                        "format": "int32"
                    },
                    "businessLayout": {
                        "pattern": "^[A-K](-?[A-K])*$",
                        "type": "string"
                    },
                    "economyRows": {
                        "maximum": 70,
                        "minimum": 1,
                        "type": "integer",
                        "format": "int32"
                    },
                    "economyLayout": {
                        "pattern": "^[A-K](-?[A-K])*$",
                        "type": "string"
                    }
                }
            },
            "StatusChangeRequest": {
                "required": [
                    "status"
                ],
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "SCHEDULED",
                            "DELAYED",
                            "BOARDING",
                            "DEPARTED",
                            "ARRIVED",
                            "CANCELLED"
                        ]
                    },
                    "delayMinutes": {
                        "maximum": 1440,
                        "minimum": 0,
                        "type": "integer",
                        "format": "int32"
                    },
                    "reason": {
                        "maxLength": 300,
                        "minLength": 0,
                        "type": "string"
                    },
                    "gate": {
                        "maxLength": 6,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "PageResponseFlightResponse": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FlightResponse"
                        }
                    },
                    "page": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "totalElements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "totalPages": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "FlightStats": {
                "type": "object",
                "properties": {
                    "total": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "scheduled": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "delayed": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "cancelled": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "boarding": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "departed": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "arrived": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "activeNow": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "departingToday": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
